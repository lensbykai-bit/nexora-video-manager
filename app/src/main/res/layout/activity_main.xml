<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#06111F">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎬  MovieScript Dub AI  PRO" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="25sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ElevenLabs • Auto Speaker • TTS" android:textColor="#FF6FB5" android:textSize="14sp" android:layout_marginBottom="18dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔑 API KEY SETUP" android:textColor="#FF5EAD" android:textStyle="bold" android:textSize="17sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ElevenLabs API Key" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="14dp"/>
<EditText android:id="@+id/elevenKey" android:layout_width="match_parent" android:layout_height="54dp" android:hint="បញ្ចូល ElevenLabs API Key" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#8295AE" android:backgroundTint="#31D7C8"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gemini API Key (សម្រាប់បកប្រែ)" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="18dp"/>
<EditText android:id="@+id/geminiKey" android:layout_width="match_parent" android:layout_height="54dp" android:hint="បញ្ចូល Gemini API Key" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#8295AE" android:backgroundTint="#31D7C8"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gemini Model" android:textColor="#AFC0D6" android:layout_marginTop="10dp"/>
<Spinner android:id="@+id/geminiModelSpinner" android:layout_width="match_parent" android:layout_height="50dp" android:background="#102238" android:popupBackground="#102238"/>
<CheckBox android:id="@+id/translateCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="បកប្រែ Script ដោយ Gemini" android:textColor="#DCE7F5" android:checked="true" android:buttonTint="#FF3E9E"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📁 ជ្រើសប្រភពមាតិកា" android:textColor="#FF5EAD" android:textStyle="bold" android:textSize="17sp" android:layout_marginTop="20dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<Button android:id="@+id/pickButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="🎥 VIDEO / AUDIO" android:textColor="#FFFFFF" android:backgroundTint="#F22C91"/>
<Button android:id="@+id/srtButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="📄 SRT" android:textColor="#FFFFFF" android:backgroundTint="#142942" android:layout_marginStart="8dp"/>
</LinearLayout>
<TextView android:id="@+id/fileText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="មិនទាន់ជ្រើស Video / Audio" android:textColor="#AFC0D6" android:padding="12dp" android:background="#0C1C2E" android:layout_marginTop="10dp"/>
<Button android:id="@+id/transcribeButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="✨ AUTO SCRIPT + ចាប់តួអង្គ" android:textColor="#FFFFFF" android:backgroundTint="#F22C91" android:layout_marginTop="14dp"/>
<LinearLayout android:id="@+id/progressPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:layout_marginTop="10dp" android:background="#0C1C2E" android:visibility="gone">
<TextView android:id="@+id/progressTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto Script" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
<ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="14dp" android:max="100" android:progress="0" android:progressTint="#FF3E9E" android:layout_marginTop="9dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">
<TextView android:id="@+id/progressPercent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="0%" android:textColor="#FF6FB5" android:textStyle="bold" android:textSize="22sp"/>
<TextView android:id="@+id/progressTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#AFC0D6" android:textSize="15sp"/>
</LinearLayout>
<TextView android:id="@+id/progressHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Uploading video…\n2. Speech Recognition (STT)…\n3. Detecting Speakers…\n4. Generating Script…" android:textColor="#B8C7D8" android:textSize="13sp" android:lineSpacingExtra="5dp" android:layout_marginTop="5dp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="👥 Script &amp; Speakers" android:textColor="#FF5EAD" android:textStyle="bold" android:textSize="17sp" android:layout_marginTop="18dp"/>
<EditText android:id="@+id/scriptText" android:layout_width="match_parent" android:layout_height="300dp" android:gravity="top|start" android:hint="Script និង Speaker នឹងបង្ហាញទីនេះ" android:textColor="#FFFFFF" android:textColorHint="#7D91A9" android:background="#0C1C2E" android:padding="12dp" android:layout_marginTop="8dp" android:inputType="textMultiLine"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="👥 Load Voices + Auto Assign" android:textColor="#FF5EAD" android:textStyle="bold" android:textSize="17sp" android:layout_marginTop="18dp"/>
<Button android:id="@+id/voicesButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="LOAD VOICES + AUTO ASSIGN" android:textColor="#FFFFFF" android:backgroundTint="#7A18F7"/>
<TextView android:id="@+id/mappingText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speaker → Voice mapping នឹងបង្ហាញទីនេះ" android:textColor="#AFC0D6" android:padding="12dp" android:background="#0C1C2E"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ElevenLabs Voice Model" android:textColor="#AFC0D6" android:layout_marginTop="10dp"/>
<Spinner android:id="@+id/modelSpinner" android:layout_width="match_parent" android:layout_height="50dp" android:background="#102238" android:popupBackground="#102238"/>
<Button android:id="@+id/translateButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="🌐 បកប្រែ Script → Khmer" android:textColor="#FFFFFF" android:backgroundTint="#F22C91" android:layout_marginTop="12dp"/>
<Button android:id="@+id/voiceAllButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="🎙 VOICE ALL — GENERATE ទាំងអស់" android:textColor="#FFFFFF" android:backgroundTint="#F22C91" android:layout_marginTop="10dp"/>
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="រួចរាល់។" android:textColor="#F9A8D4" android:padding="12dp" android:layout_marginTop="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_marginBottom="20dp">
<Button android:id="@+id/outputButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp" android:text="📁 Output Folder" android:textColor="#FFFFFF" android:backgroundTint="#5B2BD5"/>
<Button android:id="@+id/exportButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp" android:text="⬇ Export Audio / SRT" android:textColor="#FFFFFF" android:backgroundTint="#1479D1" android:layout_marginStart="8dp"/>
</LinearLayout>
</LinearLayout></ScrollView>