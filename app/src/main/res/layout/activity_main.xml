<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#07101D">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MovieScript Dub AI" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="26sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ElevenLabs • Auto Speaker • TTS" android:textColor="#F472B6" android:textSize="14sp" android:layout_marginBottom="18dp"/>
<EditText android:id="@+id/elevenKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ElevenLabs API Key" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#8FA3BD"/>
<EditText android:id="@+id/geminiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Gemini API Key (សម្រាប់បកប្រែ)" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#8FA3BD" android:layout_marginTop="8dp"/>
<Button android:id="@+id/pickButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ជ្រើស VIDEO / AUDIO" android:layout_marginTop="16dp"/>
<TextView android:id="@+id/fileText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="មិនទាន់ជ្រើស file" android:textColor="#AFC0D6" android:layout_marginTop="8dp"/>
<Button android:id="@+id/transcribeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AUTO SCRIPT + ចាប់តួអង្គ" android:layout_marginTop="18dp"/>
<LinearLayout android:id="@+id/progressPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:layout_marginTop="10dp" android:background="#0D1829" android:visibility="gone">
<TextView android:id="@+id/progressTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="កំពុងដំណើរការ…" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
<ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:max="100" android:progress="0" android:layout_marginTop="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
<TextView android:id="@+id/progressPercent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="0%" android:textColor="#F472B6" android:textStyle="bold" android:textSize="18sp"/>
<TextView android:id="@+id/progressTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#AFC0D6" android:textSize="15sp"/>
</LinearLayout>
<TextView android:id="@+id/progressHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="សូមរង់ចាំ…" android:textColor="#8FA3BD" android:textSize="12sp" android:layout_marginTop="4dp"/>
</LinearLayout>
<Button android:id="@+id/voicesButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LOAD VOICES + AUTO ASSIGN" android:layout_marginTop="10dp"/>
<TextView android:id="@+id/mappingText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speaker → Voice mapping នឹងបង្ហាញទីនេះ" android:textColor="#AFC0D6" android:padding="10dp"/>
<Spinner android:id="@+id/modelSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
<Button android:id="@+id/translateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="បកប្រែទៅខ្មែរ" android:layout_marginTop="12dp"/>
<Button android:id="@+id/voiceAllButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VOICE ALL — GENERATE ទាំងអស់" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="រួចរាល់។" android:textColor="#F9A8D4" android:layout_marginTop="16dp"/>
<EditText android:id="@+id/scriptText" android:layout_width="match_parent" android:layout_height="360dp" android:gravity="top|start" android:hint="Script នឹងបង្ហាញទីនេះ" android:textColor="#FFFFFF" android:textColorHint="#7D91A9" android:background="#0D1829" android:padding="12dp" android:layout_marginTop="12dp" android:inputType="textMultiLine"/>
</LinearLayout></ScrollView>